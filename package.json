{
  "name": "watodo",
  "version": "1.0.0",
  "description": "WhatsApp To Do group chat listener, multi-source content enrichment engine, and AI-ready Markdown knowledge base generator",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:ui\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:ui": "vite --config vite.config.ts",
    "build": "tsc && vite build --config vite.config.ts",
    "start": "node dist/server.js",
    "parse:archive": "tsx src/scripts/importArchive.ts",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@google/generative-ai": "^0.14.0",
    "@octokit/rest": "^20.0.2",
    "@whiskeysockets/baileys": "^6.7.13",
    "axios": "^1.6.8",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fs-extra": "^11.2.0",
    "qrcode": "^1.5.3",
    "qrcode-terminal": "^0.12.0",
    "slugify": "^1.6.6",
    "turndown": "^7.1.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.24",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@types/turndown": "^5.0.4",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4"
  }
}
